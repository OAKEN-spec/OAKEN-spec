{
  "name": "lock-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "LockVault and PositionLock: non-upgradeable token and LP-lock escrows designed to deploy at one identical address on every EVM chain. Self-contained Hardhat project.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "hardhat compile --config hardhat.config.ts",
    "test": "hardhat test --config hardhat.config.ts",
    "typecheck": "tsc --noEmit",
    "addresses": "hardhat run scripts/deterministic-addresses.ts --config hardhat.config.ts",
    "coverage": "hardhat coverage --config hardhat.coverage.config.ts",
    "test:foundry": "forge test --match-path \"test/foundry/*\"",
    "test:invariant": "forge test --match-path test/foundry/LockVaultInvariant.t.sol",
    "coverage:foundry": "forge coverage --ir-minimum",
    "addresses:v2": "hardhat run scripts/deterministic-addresses-v2.ts",
    "addresses:v3": "hardhat run scripts/deterministic-addresses-v3.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.6",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
